# ╔═╡ d16dff45-2a6b-489b-b13b-e49fb5a4f95a
function runPD(z)
	cov, cens, status = cleaning(z)
	nP = size(cov)[1]
	tl = makeTimeline(nP)
	final = increment(tl, nP, cov, status)
	cF, cC = computeCost(final)
	return cF+cC, final, cens
end

