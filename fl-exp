# ╔═╡ ea3d3b57-c37d-4a2d-9c9a-6d50e49f7eca
function genArrays(groups, out)
	rw = []
	cl = []
	dt = []
	A = spzeros(n+n*m+om, n+n*m+m)
	b = zeros(n*m+n+om)
	f = zeros(n*m+m+n)

	#go by row
	#sum_i x_ij + z_j >= 1
	for j in 1:n 
		for i in 1:m
			A[j,(j-1)*m+i] = -1
		end
		A[j,m*n+j] = -1

		b[j] = -1
	end

	#x_ij <= y_i
	for j in 1:n 
		for i in 1:m
			A[n+(j-1)*m+i,(j-1)*m+i] = 1

			A[n+(j-1)*m+i,m*n+n+i] = -1
		end
	end

	#sum_{j in C_g}z_j <= l_g
	for g in 1:size(out)[1]
		for j in 1:n
			if groups[j] == g
				A[n+n*m+g,n*m+j] = 1
			end
		end
		b[n+n*m+g] = out[g]
	end

	#make fOPT
	#sum_j sum_i d_ij x_ij
	for j in 1:n 
		for i in 1:m
			f[(j-1)*m+i] = dist[j][i]
		end
	end

	#sum_j 0z_j

	#sum_i f_i y_i
	for i in 1:m 
		f[n*m+n+i] = costs[i]
	end

	return A, b, f
		
end

# ╔═╡ 580fc4c1-e402-4b2c-bab3-b1336602a53c
eps = 0.05

# ╔═╡ f83df1c6-c65b-4d15-b3f6-e6079bc64dc1
function solveLP(groups, out)
	A, b, f = genArrays(groups, out)
	x = Variable(m*n+m+n)
	constraints = [A*x<=b, x>=0, x<=1]
	problem = minimize(dot(f,x), constraints)
	solve!(problem, SCS.Optimizer)
	z = x.value[m*n+1:m*n+n]
	OPTval = problem.optval
	return z, OPTval
end

# ╔═╡ 01cfb554-1e07-4e7c-8e96-c1d18e55a75b
function cleaning(zVec)
	status = Dict()
	p = []
	lEps = zeros(om)
	for j in 1:n
		if zVec[j] >= 1-eps
			status[j] = 1
			lEps[groupsF[j]] += 1
		else
			push!(p,j)
			status[j] = 2
		end
	end
	return p, lEps, status
end

# ╔═╡ dd63288f-8cf3-42c2-a32c-c969ef53c106
function makeTimeline(nF)
	tl = []
	for j in 1:nF
		for i in 1:m
			push!(tl, [j,i]) #facility, client index
		end
	end
	sort!(tl, by = x -> dist[x[1]][x[2]])
	return tl
end

# ╔═╡ 21095385-460f-4309-bc0a-de8eee78e6bb
function openFac(i0, isOpen, contributors, cities, status)
	isOpen[i0] = true
	for j in contributors[i0]
		if status[j] == 2
			status[j] = 3
			push!(cities[i0], j)
		end
	end
end

# ╔═╡ 14bbc3db-1dd3-49dd-afcd-637cdd9367fa
function event(i0, jin0, isOpen, contributors, cities, nUP, pCov, status)
	j0 = pCov[jin0]
	if status[j0] == 2 && isOpen[i0]
		status[j0] = 3
		push!(cities[i0], j0)
	elseif status[j0] == 2 && !isOpen[i0]
		push!(contributors[i0], j0)
	end

	t = dist[j0][i0]

	for i in 1:m
		if !isOpen[i]
			cont = 0
			for j in contributors[i]
				if status[j] == 2
					cont += t - dist[j][i0]
				end
			end
			if cont >= costs[i]
				openFac(i, isOpen, contributors, cities, status)
			end
		end
	end

	for j in pCov
		if status[j] == 2
			return false
		end
	end
	return true
end
	

# ╔═╡ 4689e604-2545-4e0f-b03b-e59fea29de41
function increment(timeline, nUP, pCov, status)
	isOpen = Dict()
	contributors = Dict()
	cities = Dict()
	for i in 1:m
		isOpen[i] = false
		contributors[i] = []
		cities[i] = []
	end
	for e in timeline
		done = event(e[2],e[1], isOpen, contributors, cities, nUP, pCov, status) #facility, client index
		if done
			break
		end
	end
	return cities
end

# ╔═╡ 69e7f2ff-eefc-4fb7-bc46-8b9a4901e62c
function computeCost(cities)
	fCost = 0
	cCost = 0
	for i in 1:m
		if size(cities[i])[1] != 0
			fCost += costs[i]
			for j in cities[i]
				cCost += dist[j][i]
			end
		end
	end
	return fCost, cCost
end

